-- ========== Helpers ==========
local function Notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = dur or 2
        })
    end)
end

local function Corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function Stroke(parent, thickness, color)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Color = color or Color3.fromRGB(40, 70, 120)
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function CreateLabel(parent, text, size, position, textSize, color)
    local label = Instance.new("TextLabel")
    label.Size = size
    label.Position = position
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color or Color3.fromRGB(210, 225, 255)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = textSize or 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    return label
end

-- Soft hover effect helper
local function AddHover(btn, normalColor, hoverColor)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = hoverColor}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = normalColor}):Play()
    end)
end

-- ========== Toggle Switch ==========
local function MakeToggle(parent, text, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -20, 0, 34)
    frame.BackgroundTransparency = 1
    frame.Parent = parent

    local label = CreateLabel(frame, text, UDim2.new(1, -58, 1, 0), UDim2.new(0, 0, 0, 0), 13)

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 44, 0, 24)
    track.Position = UDim2.new(1, -44, 0.5, -12)
    track.BackgroundColor3 = Color3.fromRGB(30, 45, 75)
    track.BorderSizePixel = 0
    track.Parent = frame
    Corner(track, 12)
    Stroke(track, 1, Color3.fromRGB(50, 80, 130))

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = UDim2.new(0, 2, 0.5, -10)
    knob.BackgroundColor3 = Color3.fromRGB(180, 200, 240)
    knob.BorderSizePixel = 0
    knob.Parent = track
    Corner(knob, 10)

    local enabled = default or false

    local function setState(state, animate)
        enabled = state
        local goalPos = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
        local goalColor = state and Color3.fromRGB(0, 120, 220) or Color3.fromRGB(30, 45, 75)
        local knobColor = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 200, 240)

        if animate then
            TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = goalPos}):Play()
            TweenService:Create(track, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {BackgroundColor3 = goalColor}):Play()
            TweenService:Create(knob, TweenInfo.new(0.22), {BackgroundColor3 = knobColor}):Play()
        else
            knob.Position = goalPos
            track.BackgroundColor3 = goalColor
            knob.BackgroundColor3 = knobColor
        end
    end

    setState(enabled, false)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = frame
    btn.MouseButton1Click:Connect(function()
        setState(not enabled, true)
        callback(enabled)
    end)

    return { Set = function(v) setState(v, true) end, Get = function() return enabled end }
end

