    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        StatsFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ========== FARM LOGIC (Safer Tweens) ==========
local coinCache = {}
local lastScan = 0
local currentTween = nil

local function forceNoClip()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function findCoins()
    local coins = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsA("Terrain") and obj.CanCollide == false then
            local n = obj.Name:lower()
            if n:find("coin") or n:find("money") or n:find("gem") or n:find("gold") or n:find("cash") or n:find("collect") or n:find("loot") then
                table.insert(coins, obj)
            end
        end
    end
    return coins
end

local function collectCoin(coin)
    if not coin or not coin.Parent then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    root.CFrame = CFrame.new(coin.Position + Vector3.new(0, 2.2, 0))
    task.wait(0.07)
    pcall(function()
        firetouchinterest(root, coin, 0)
        firetouchinterest(root, coin, 1)
    end)
    local cd = coin:FindFirstChildOfClass("ClickDetector")
    if cd then pcall(fireclickdetector, cd) end
    local prompt = coin:FindFirstChildOfClass("ProximityPrompt") or (coin.Parent and coin.Parent:FindFirstChildOfClass("ProximityPrompt"))
    if prompt then pcall(fireproximityprompt, prompt) end
    task.wait(0.12)

    local success = not coin.Parent
    if success then
        State.CoinsCollected += 1
    end
    return success
end

local function moveToPosition(targetPos)
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end

    local dist = (root.Position - targetPos).Magnitude
    if dist < 0.6 then return true end

    -- Safer speed calculation
    local speed = State.FlySpeed * (0.75 + math.random() * 0.25)   -- lower multiplier
    local duration = math.clamp(dist / speed, 0.35, 4.2)           -- longer minimum & maximum

    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(targetPos)
    })
    currentTween = tween

    local finished = false
    tween.Completed:Connect(function()
        finished = true
        currentTween = nil
    end)
    tween:Play()

    local start = tick()
    while not finished do
        if not root.Parent then
            if currentTween then currentTween:Cancel() end
            return false
        end
        forceNoClip()
        if tick() - start > 6 then          -- longer timeout
            if currentTween then currentTween:Cancel() end
            break
        end
        task.wait(0.1)
    end
    return true
end

