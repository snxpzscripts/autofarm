-- Main farm loop
task.spawn(function()
    while task.wait(0.1) do
        if State.CoinFarm then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                forceNoClip()
                if root.Position.Y < -8 then
                    root.CFrame = CFrame.new(root.Position.X, 7, root.Position.Z)
                end

                if #coinCache > 0 then
                    local nearest, minDist = nil, math.huge
                    for _, coin in pairs(coinCache) do
                        if coin and coin.Parent then
                            local d = (root.Position - coin.Position).Magnitude
                            if d < minDist then
                                nearest = coin
                                minDist = d
                            end
                        end
                    end

                    if nearest then
                        local safePos = nearest.Position + Vector3.new(0, 3.2 + math.random() * 1.2, 0)
                        moveToPosition(safePos)
                        collectCoin(nearest)

                        for i, c in pairs(coinCache) do
                            if c == nearest then
                                table.remove(coinCache, i)
                                break
                            end
                        end

                        -- Safer delay
                        task.wait(State.CollectDelay * (0.9 + math.random() * 0.35))
                    end
                else
                    -- gentle wander
                    root.CFrame = root.CFrame + Vector3.new(math.random(-1.5, 1.5), 0, math.random(-1.5, 1.5))
                    task.wait(1.6 + math.random())
                end
            end
        else
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
            task.wait(0.5)
        end
    end
end)

