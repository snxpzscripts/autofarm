local invisSeatName = "invischair"
local invisPos = Vector3.new(-25.95, 400, 3537.55)
local invisDescConn, invisRefreshConn = nil, nil

local function invisClearConns()
    if invisDescConn then pcall(function() invisDescConn:Disconnect() end); invisDescConn = nil end
    if invisRefreshConn then pcall(function() invisRefreshConn:Disconnect() end); invisRefreshConn = nil end
