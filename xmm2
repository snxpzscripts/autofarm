local function invisApplyChar(ch)
    if not ch then return false end
    local rp = ch:FindFirstChild("HumanoidRootPart") or ch:WaitForChild("HumanoidRootPart", 3)
    if not rp then return false end
    invisSetTransp(ch, invisTransp)
