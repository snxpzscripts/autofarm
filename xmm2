-- Shoot Murderer
local function getShootRemote()
    local function findIn(parent)
        if not parent then return nil end
        local f = parent:FindFirstChild("Shoot")
        if f and f:IsA("RemoteEvent") then return f end
        f = parent:FindFirstChild("Shoot", true)
        return (f and f:IsA("RemoteEvent")) and f or nil
    end
    local r = findIn(ReplicatedStorage) if r then return r end
    if ReplicatedStorage:FindFirstChild("Remotes") then r = findIn(ReplicatedStorage.Remotes) if r then return r end end
    if type(getgenv) == "function" then
        local env = getgenv()
        if env.getNil then r = env.getNil("Shoot","RemoteEvent") if r then return r end end
        if env.getnilinstances then
            for _, inst in ipairs(env.getnilinstances()) do
                if inst.Name == "Shoot" and inst:IsA("RemoteEvent") then return inst end
            end
        end
    end
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d.Name == "Shoot" and d:IsA("RemoteEvent") then return d end
    end
    local gun = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun")) or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Gun"))
    if gun then
        local s = gun:FindFirstChild("Shoot") if s and s:IsA("RemoteEvent") then return s end
        s = gun:FindFirstChild("Shoot", true) if s and s:IsA("RemoteEvent") then return s end
    end
    return nil
end
local cachedShootRemote = nil
local function ShootMurdererOnce()
    local character = getCharacter(); local humanoid = getHumanoid()
    if not character or not humanoid or humanoid.Health <= 0 then return end
    local target = GetMurdererPlayer()
    if not target or not target.Character then return end
    local tr = target.Character:FindFirstChild("HumanoidRootPart") if not tr then return end
    local gun = character:FindFirstChild("Gun") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Gun"))
    if gun and not character:FindFirstChild("Gun") then pcall(function() gun.Parent = character end) end
    local vel = tr.AssemblyLinearVelocity or tr.Velocity or Vector3.new()
    local hitPos = tr.Position + vel * 0.15
    local remote = (cachedShootRemote and cachedShootRemote.Parent) or getShootRemote()
    cachedShootRemote = remote
    if remote then
        local cam = workspace.CurrentCamera
        local origin = (cam and cam.CFrame) or (getRoot() and getRoot().CFrame) or CFrame.new()
        pcall(function() remote:FireServer(origin, CFrame.new(hitPos)) end)
        return
    end
    gun = character:FindFirstChild("Gun")
    if gun then
        local kl = gun:FindFirstChild("KnifeLocal")
        local cb = kl and kl:FindFirstChild("CreateBeam")
        local rf = cb and (cb:FindFirstChild("RemoteFunction") or (cb:IsA("RemoteFunction") and cb))
        if rf and rf.InvokeServer then pcall(function() rf:InvokeServer(1, hitPos, "AH2") end) end
    end
end
