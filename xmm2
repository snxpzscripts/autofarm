local function ExecuteThrowAtNearest()
    local character = getCharacter(); local humanoid = getHumanoid(); local backpack = getBackpack()
    if not character or not humanoid or not backpack then return end
    local knife = backpack:FindFirstChild("Knife") or character:FindFirstChild("Knife")
    if knife and knife.Parent == backpack then
        pcall(function() humanoid:EquipTool(knife) end); task.wait(0.1); knife = character:FindFirstChild("Knife")
    end
    if not knife then return end
    local throwRemote = knife:FindFirstChild("Throw")
    if not throwRemote or not throwRemote:IsA("RemoteEvent") then return end
    local root = getRoot() if not root then return end
    local myPos = root.Position; local target = nil; local best = math.huge
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            local hum = v.Character:FindFirstChildOfClass("Humanoid")
            local er = v.Character:FindFirstChild("HumanoidRootPart") or v.Character.PrimaryPart
            if hum and hum.Health > 0 and er then
                local m = (myPos - er.Position).Magnitude
                if m < best then best = m; target = er end
            end
        end
    end
    if target then
        local vel = target.AssemblyLinearVelocity or target.Velocity or Vector3.new()
        local pred = target.Position + vel * math.clamp(best/1000, 0.05, 0.35)
        pcall(function() throwRemote:FireServer(CFrame.new(myPos, pred), pred) end)
    end
end
