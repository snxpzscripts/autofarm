local function dupeBeachballs(multiplier)
    pcall(function()
        local EventFrames = LocalPlayer.PlayerGui.CrossPlatform.Christmas2025.Container.EventFrames
        local function getOldValue() return tonumber(EventFrames.BattlePass.Info.Tokens.Container.TextLabel.Text) end
        local gui_list = {
            EventFrames.BattlePass.Info.Tokens.Container.TextLabel,
            EventFrames.MysteryBox.Info.Tokens.Container.TextLabel,
            EventFrames.PurchaseCurrency.Info.Tokens.Container.TextLabel
        }
        local old_value = getOldValue(); local new_value = old_value * multiplier
        for _, v in pairs(gui_list) do v.Text = new_value end
    end)
end

