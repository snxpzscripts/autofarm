    seat.Name = invisSeatName; seat.Transparency = 1; seat.CanCollide = false; seat.Anchored = false
    seat.Position = invisPos; seat.Parent = workspace
    local w1 = Instance.new("Weld"); w1.Part0 = seat; w1.Part1 = torso; w1.Parent = seat
    local w2 = Instance.new("Weld"); w2.Part0 = seat; w2.Part1 = rp; w2.Parent = seat
    task.wait(); pcall(function() seat.CFrame = saveCF end)
    invisDescConn = ch.DescendantAdded:Connect(function(d)
        if not invisEnabled then return end
        if d:IsA("BasePart") then
            if d.Name ~= "HumanoidRootPart" then d.Transparency = invisTransp end
            d.LocalTransparencyModifier = invisTransp
        elseif d:IsA("Decal") or d:IsA("Texture") then
            d.Transparency = invisTransp
        end
    end)
    local nxt = 0
    invisRefreshConn = RunService.Heartbeat:Connect(function()
        if not invisEnabled then return end
        local t = tick(); if t < nxt then return end; nxt = t + 0.1
