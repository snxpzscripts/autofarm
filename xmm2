do
    local AutofarmMainSection = Tabs.AutofarmTab:Section({ Title = "Coin Autofarm", Desc = "Collect coins automatically", Box = true, BoxBorder = true, Opened = true })
    AutofarmMainSection:Toggle({
        Title = "Enable Fastest Autofarm", Default = false,
        Callback = function(state)
            fastestAutofarmEnabled = state
            if state then
                collectedCoins = 0; roundStartTime = tick()
                if fastestAutofarmThread then task.cancel(fastestAutofarmThread) end
                fastestAutofarmThread = task.spawn(function()
                    if not OctreeModule then WindUI:Notify({ Title = "Autofarm Error", Desc = "Octree module failed to load", Icon = "x-circle", Duration = 5 }); return end
                    local LP = LocalPlayer; local octree = OctreeModule.new()
                    local function populateOctree()
                        octree:ClearAllNodes(); local map = getMap()
                        if not map or not map:FindFirstChild("CoinContainer") then return end
                        for _, coin in ipairs(map.CoinContainer:GetChildren()) do
                            local v = coin:FindFirstChild("CoinVisual")
                            if v and not v:GetAttribute("Collected") then octree:CreateNode(coin.Position, coin) end
                        end
                    end
                    local function getNearestCoinAwayFromMurderer(cp)
                        if not cp then return nil end; populateOctree()
                        local cand = octree:GetNearest(cp, fastestAutofarmRadius, 10)
                        if not cand or #cand == 0 then return nil end
                        local murderer = GetMurdererPlayer(); local mpos = nil
                        if murderer and murderer.Character then local h = murderer.Character:FindFirstChild("HumanoidRootPart") if h then mpos = h.Position end end
                        if not mpos then return cand[1] and cand[1].Object or nil end
                        local best, bd = nil, -1
                        for _, n in ipairs(cand) do local c = n and n.Object if c and c.Position then local d = (c.Position - mpos).Magnitude if d > bd then bd = d; best = c end end end
                        return best or (cand[1] and cand[1].Object or nil)
                    end
                    local function moveToPositionSlowly(character, tp, dur)
                        if not character or not tp then return end
                        local sp = character:GetPivot().Position; local st = tick()
                        while fastestAutofarmEnabled do
                            local a = math.min((tick()-st)/dur, 1)
                            character:PivotTo(CFrame.new(sp:Lerp(tp, a)))
                            if a >= 1 then task.wait(0.2); break end
                            task.wait()
                        end
                    end
                    local function waitForCharacter()
                        while fastestAutofarmEnabled do
                            local C = LP.Character
                            if C and LP:GetAttribute("Alive") then
                                local HRP = C:FindFirstChild("HumanoidRootPart"); local H = C:FindFirstChild("Humanoid")
                                if HRP and H then return C, HRP, H end
                            end
                            task.wait(0.5)
                        end
                        return nil, nil, nil
                    end
                    while fastestAutofarmEnabled do
                        local Char = waitForCharacter(); if not Char then break end
                        local map = getMap()
                        while fastestAutofarmEnabled and not map do task.wait(1); map = getMap() end
                        if not fastestAutofarmEnabled then break end
                        while fastestAutofarmEnabled do
                            if not (Char and Char.Parent and LP:GetAttribute("Alive")) then break end
                            if not Char:FindFirstChild("Humanoid") then break end
                            local cp = Char:GetPivot().Position; local target = getNearestCoinAwayFromMurderer(cp)
                            if target then
                                local tp = target.Position; local dist = (cp-tp).Magnitude; local dur = math.max(0.5, dist/fastestAutofarmSpeed)
                                if pcall(function() moveToPositionSlowly(Char, tp, dur) end) then
                                    local v = target:FindFirstChild("CoinVisual"); local wt = 0
                                    while fastestAutofarmEnabled and v and not v:GetAttribute("Collected") and v.Parent and wt < 10 do
                                        if not LP:GetAttribute("Alive") then break end
                                        local nt = getNearestCoinAwayFromMurderer(Char:GetPivot().Position)
                                        if nt and nt ~= target then break end
                                        task.wait(0.1); wt = wt + 0.1
                                    end
                                    collectedCoins = collectedCoins + 1
                                    WindUI:Notify({ Title = "Coin Collected!", Desc = "Total Coins: " .. collectedCoins, Duration = 2 })
                                else
                                    WindUI:Notify({ Title = "Error", Desc = "Move failed, retrying...", Duration = 2 }); task.wait(1)
                                end
                            else task.wait(2) end
                            if not target and (tick()-roundStartTime) > 30 then
                                WindUI:Notify({ Title = "Safety Restart", Desc = "No coins found for 30s, restarting...", Duration = 3 })
                                if LP.Character and LP.Character:FindFirstChild("Humanoid") then LP.Character.Humanoid.Health = 0 end
                                task.wait(3); break
                            end
                        end
                    end
                end)
                WindUI:Notify({ Title = "Autofarm", Desc = "Autofarm activated!", Icon = "check-circle", Duration = 3 })
            else
                if fastestAutofarmThread then task.cancel(fastestAutofarmThread) end
                fastestAutofarmThread = nil
                WindUI:Notify({ Title = "Autofarm", Desc = "Autofarm deactivated!", Icon = "x-circle", Duration = 3 })
            end
        end
    })

