-- ROLE HELPERS
-- =========================
local roles, Murder, Sheriff, Hero = {}, nil, nil, nil
local lastRoleUpdate = 0

local function UpdateRoles()
    local success, result = pcall(function()
        return ReplicatedStorage:FindFirstChild("GetPlayerData", true):InvokeServer()
    end)
    if success and type(result) == "table" then
        roles = result
        Murder, Sheriff, Hero = nil, nil, nil
        for name, data in pairs(roles) do
            if type(data) == "table" then
                if data.Role == "Murderer" then Murder = name
                elseif data.Role == "Sheriff" then Sheriff = name
                elseif data.Role == "Hero" then Hero = name end
            end
        end
    end
end

local function HasTool(plr, toolName)
    if not plr then return false end
    local bp = plr:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild(toolName) then return true end
    local ch = plr.Character
    if ch and ch:FindFirstChild(toolName) then return true end
    return false
end

local function playerExists(name) return name and Players:FindFirstChild(name) ~= nil end

local function RefreshRoles(force)
    if not force and tick() - lastRoleUpdate < 0.4 then return end
    lastRoleUpdate = tick()
    pcall(UpdateRoles)
    if not playerExists(Murder) then Murder = nil end
    if not playerExists(Sheriff) then Sheriff = nil end
    if not playerExists(Hero) then Hero = nil end
    if not Murder then
        for _, plr in ipairs(Players:GetPlayers()) do
            if HasTool(plr, "Knife") then Murder = plr.Name break end
        end
    end
    if not Sheriff then
        for _, plr in ipairs(Players:GetPlayers()) do
            if HasTool(plr, "Gun") then Sheriff = plr.Name break end
        end
    end
end

local function GetMurdererPlayer()
    RefreshRoles()
    if Murder then local p = Players:FindFirstChild(Murder) if p then return p end end
    for _, plr in ipairs(Players:GetPlayers()) do if HasTool(plr, "Knife") then return plr end end
    return nil
end

local function GetSheriffPlayer()
    RefreshRoles()
    if Sheriff then local p = Players:FindFirstChild(Sheriff) if p then return p end end
    if Hero then local p = Players:FindFirstChild(Hero) if p then return p end end
    for _, plr in ipairs(Players:GetPlayers()) do if HasTool(plr, "Gun") then return plr end end
    return nil
end

local function GetHeroPlayer()
    RefreshRoles()
    if Hero then local p = Players:FindFirstChild(Hero) if p then return p end end
    return nil
end

local function GetRoleOfPlayer(plr)
    if not plr then return "Innocent" end
    RefreshRoles()
    local data = roles[plr.Name]
    if type(data) == "table" and data.Role then
        if data.Role == "Murderer" then return "Murderer"
        elseif data.Role == "Sheriff" or data.Role == "Hero" then return "Sheriff" end
    end
    if Murder == plr.Name or HasTool(plr, "Knife") then return "Murderer" end
    if Sheriff == plr.Name or Hero == plr.Name or HasTool(plr, "Gun") then return "Sheriff" end
    return "Innocent"
end

local function IsAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local data = roles[plr.Name]
    if type(data) == "table" and (data.Killed or data.Dead) then return false end
    return true
end

